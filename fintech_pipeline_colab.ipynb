    {
      "cell_type": "code",
      "source": [
        "from pyspark.sql.functions import col, lit\n",
        "\n",
        "# Select records in a deterministic order\n",
        "ordered_df = raw_df.orderBy(\"transaction_id\")\n",
        "\n",
        "# Create duplicate transactions (2% of original records)\n",
        "duplicate_records = ordered_df.limit(2000)\n",
        "\n",
        "# Create records with missing customer IDs (1%)\n",
        "missing_customer = (\n",
        "    ordered_df.filter(col(\"customer_id\").isNotNull())\n",
        "    .limit(1000)\n",
        "    .withColumn(\"customer_id\", lit(None).cast(\"integer\"))\n",
        ")\n",
        "\n",
        "# Create records with missing amounts (1%)\n",
        "missing_amount = (\n",
        "    ordered_df.filter(col(\"amount\").isNotNull())\n",
        "    .limit(1000)\n",
        "    .withColumn(\"amount\", lit(None).cast(\"double\"))\n",
        ")\n",
        "\n",
        "# Create invalid transaction statuses (1%)\n",
        "invalid_status = (\n",
        "    ordered_df.limit(1000)\n",
        "    .withColumn(\"transaction_status\", lit(\"UNKNOWN\"))\n",
        ")\n",
        "\n",
        "# Create negative transaction amounts (1%)\n",
        "negative_amount = (\n",
        "    ordered_df.limit(1000)\n",
        "    .withColumn(\"amount\", -col(\"amount\"))\n",
        ")\n",
        "\n",
        "# Create missing currencies (1%)\n",
        "missing_currency = (\n",
        "    ordered_df.limit(1000)\n",
        "    .withColumn(\"currency\", lit(None).cast(\"string\"))\n",
        ")\n",
        "\n",
        "# Combine all records\n",
        "source_with_issues = (\n",
        "    raw_df\n",
        "    .unionByName(duplicate_records)\n",
        "    .unionByName(missing_customer)\n",
        "    .unionByName(missing_amount)\n",
        "    .unionByName(invalid_status)\n",
        "    .unionByName(negative_amount)\n",
        "    .unionByName(missing_currency)\n",
        ")\n",
        "\n",
        "print(\"Original records:\", raw_df.count())\n",
        "print(\"Records after introducing issues:\", source_with_issues.count())\n",
        "\n",
        "source_with_issues.write \\\n",
        "    .mode(\"overwrite\") \\\n",
        "    .option(\"header\", True) \\\n",
        "    .csv(\"fintech_pipeline/data/raw/transactions_with_issues\")\n",
        "\n",
        "print(\"Corrupted source dataset saved successfully!\")"
      ],
