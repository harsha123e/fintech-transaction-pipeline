      "source": [
        "from pyspark.sql.functions import sum as spark_sum\n",
        "import builtins\n",
        "\n",
        "silver_total = silver_table.agg(\n",
        "    spark_sum(\"amount\").alias(\"total\")\n",
        ").first()[\"total\"]\n",
        "\n",
        "gold_total = gold_table.agg(\n",
        "    spark_sum(\"total_amount\").alias(\"total\")\n",
        ").first()[\"total\"]\n",
        "\n",
        "reconciliation_difference = silver_total - gold_total\n",
        "absolute_reconciliation_difference = abs(reconciliation_difference)\n",
        "\n",
        "tolerance = 0.01\n",
        "\n",
        "reconciliation_status = (\n",
        "    \"PASSED\"\n",
        "    if abs(reconciliation_difference) <= tolerance\n",
        "    else \"FAILED\"\n",
        ")\n",
        "\n",
        "print(\"Silver total amount:\", builtins.round(silver_total, 2))\n",
        "print(\"Gold total amount:\", builtins.round(gold_total, 2))\n",
        "print(\"Difference:\", builtins.round(reconciliation_difference, 2))\n",
        "print(\"Reconciliation tolerance:\", tolerance)\n",
        "print(\"Reconciliation status:\", reconciliation_status)"
